<?xml version="1.0" encoding="utf-8"?>
<!--
  设置界面布局。只用平台原生控件（项目没有 androidx/appcompat 依赖）。
  控件 id 与 SettingsActivity.kt 一一对应，改 id 时两处必须同步。
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingLeft="16dp"
        android:paddingTop="16dp"
        android:paddingRight="16dp"
        android:paddingBottom="24dp">

        <CheckBox
            android:id="@+id/cb_enabled"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/label_enabled" />

        <!-- ============================ 接口 ============================ -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/label_base_url"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/et_base_url"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_base_url"
            android:inputType="textUri"
            android:maxLines="1"
            android:textSize="14sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/label_api_key"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/et_api_key"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_api_key"
            android:inputType="textPassword"
            android:maxLines="1"
            android:textSize="14sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/label_model"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/et_model"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_model"
            android:inputType="text"
            android:maxLines="1"
            android:textSize="14sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/label_system_prompt"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/et_system_prompt"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="top|start"
            android:inputType="textMultiLine"
            android:maxLines="8"
            android:minLines="3"
            android:scrollbars="vertical"
            android:textSize="14sp" />

        <!-- ============================ 会话 ============================ -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/label_whitelist"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/et_whitelist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="top|start"
            android:hint="@string/hint_whitelist"
            android:inputType="textMultiLine"
            android:maxLines="10"
            android:minLines="3"
            android:scrollbars="vertical"
            android:textSize="14sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/label_nickname"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/et_nickname"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_nickname"
            android:inputType="text"
            android:maxLines="1"
            android:textSize="14sp" />

        <CheckBox
            android:id="@+id/cb_group_only_mention"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/label_group_only_mention" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/label_cooldown"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/et_cooldown"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_cooldown"
            android:inputType="number"
            android:maxLines="1"
            android:textSize="14sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/label_max_per_hour"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/et_max_per_hour"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_max_per_hour"
            android:inputType="number"
            android:maxLines="1"
            android:textSize="14sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/label_delay_min"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/et_delay_min"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_delay_min"
            android:inputType="number"
            android:maxLines="1"
            android:textSize="14sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/label_delay_max"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/et_delay_max"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_delay_max"
            android:inputType="number"
            android:maxLines="1"
            android:textSize="14sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/label_max_chars"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/et_max_chars"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_max_chars"
            android:inputType="number"
            android:maxLines="1"
            android:textSize="14sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/label_temperature"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/et_temperature"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_temperature"
            android:inputType="numberDecimal"
            android:maxLines="1"
            android:textSize="14sp" />

        <CheckBox
            android:id="@+id/cb_debug"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/label_debug" />

        <!-- ============================ 操作 ============================ -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_save"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/btn_save" />

            <Button
                android:id="@+id/btn_test"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="@string/btn_test" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:padding="8dp"
            android:text="@string/status_idle"
            android:textIsSelectable="true"
            android:textSize="14sp" />

    </LinearLayout>

</ScrollView>
